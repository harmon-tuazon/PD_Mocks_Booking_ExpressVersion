{
  "name": "mocks_booking_user",
  "version": "1.0.0",
  "description": "Student-facing booking application",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:frontend": "cd frontend && npm run dev",
