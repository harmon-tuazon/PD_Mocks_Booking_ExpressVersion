    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "joi": "^18.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
